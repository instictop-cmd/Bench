# Copy to .env.local and fill in the key.
# Get a key at https://platform.agnes-ai.com

AI_API_KEY=
AI_BASE_URL=https://apihub.agnes-ai.com/v1
AI_MODEL=agnes-3.0-flash
AI_DAILY_CAP=2000

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: shared rate limiting. Without these, limits are per-instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical URL for metadata, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://bench-sepia.vercel.app

# Optional email capture endpoint (Formspree/Tally/your own). Receives JSON {email, source}.
NEXT_PUBLIC_SIGNUP_URL=
